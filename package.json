{
  "name": "wastewater-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Global wastewater viral surveillance dashboard (SARS-CoV-2, influenza, RSV, and more)",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app shared ingestion tests --ext .ts,.tsx --max-warnings=0",
    "ingest": "tsx ingestion/run.ts",
    "ingest:all": "tsx ingestion/run.ts --all",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ingestion/tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "maplibre-gl": "^4.7.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.726.0",
    "@duckdb/node-api": "^1.1.3-alpha.7",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

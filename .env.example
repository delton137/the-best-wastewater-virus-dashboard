# Optional: Cloudflare R2 sink for the site-level Parquet lake (Option A in the plan).
# Leave unset to run ingestion locally with JSON aggregates only — the dashboard MVP
# (map + trends) works entirely from public/aggregates/*.json without R2.
#
# Create an R2 bucket + an API token (Object Read & Write) in the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wastewater-lake
R2_PREFIX=lake

# Dev-only: cap CDC rows for fast ingestion iterations (omit for full pulls).
# CDC_LIMIT=20000
